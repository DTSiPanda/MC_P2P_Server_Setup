# .env.example  –  copy to .env and fill in values; never commit .env

# ── Admin identity ──────────────────────────────────────────────────────────
# Your display name and email as the app admin (shows in player list, lock
# holder name, logs, and Tailscale invite calls).
ADMIN_NAME=YourName
ADMIN_EMAIL=you@example.com

# Phase 1 & Phase 5 – Player token (admin's API token)
PLAYER_TOKEN=change-me-to-a-long-random-string

# Phase 2 – Cloudflare R2
# Find these in Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=minecraft-p2p

# Phase 5 – Admin Secret
# ADMIN_SECRET: long random secret for admin endpoints (/admin/*)
ADMIN_SECRET=change-me-to-a-long-random-admin-secret

# Tailscale API Key (Easiest method)
# Go to Tailscale Admin Console → Settings → Keys → API access tokens → Generate access token
TAILSCALE_API_KEY=tskey-api-...
TAILSCALE_TAILNET=-

# Alternative: Tailscale OAuth Client (if using OAuth)
# TAILSCALE_CLIENT_ID=tskey-client-...
# TAILSCALE_CLIENT_SECRET=tskey-secret-...
