// Tailscale Access Control Lists (ACLs) for Rotating-Host Minecraft P2P
//
// Open ACL: all tailnet members can reach all other tailnet members on any port.
// This is correct for a small private friend group where everyone should be
// able to connect to the Minecraft host regardless of which device they use.
// All members have symmetric visibility — everyone sees everyone.

{
  "acls": [
    {
      "action": "accept",
      "src":    ["*"],
      "dst":    ["*:*"]
    }
  ]
}
